COMETAIL_API_PORT=8787
COMETAIL_API_HOST=127.0.0.1
COMETAIL_API_ORIGINS=https://cometail.fun
COMETAIL_API_RATE_PER_MINUTE=120
COMETAIL_SKY_CONFIGS=8aoFV3oVKVBuJsh7vnEKhUhR8C5D48HsjLHoVZt6WsBF,FhErNG8JK8hXM8PdkwGsfnr8jqxGuQmEWLSYjDtFGuXk,6CQ4fXLaSeR3UvgTUAffbetDuzXU4JUMjfG2KcFJFsuz,H53ojWBqXmxbtcCLVzA2YRveaNvdL1CKS11Kcwxg1Psd
