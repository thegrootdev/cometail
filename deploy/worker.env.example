COMETAIL_KEEPER_KEYPAIR=/opt/cometail/keys/devnet/keeper.json
COMETAIL_POLL_MS=15000
COMETAIL_DUST_LAMPORTS=100000
COMETAIL_MIN_ROUTE_LAMPORTS=1000000
COMETAIL_LADDER_BINS=5
COMETAIL_MIGRATE_CONFIGS=8aoFV3oVKVBuJsh7vnEKhUhR8C5D48HsjLHoVZt6WsBF
