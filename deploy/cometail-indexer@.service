[Unit]
Description=COMETAIL indexer, Sky scan and read API (loopback only; Caddy in front)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
WorkingDirectory=/opt/cometail/repo/worker
EnvironmentFile=/etc/cometail/worker.env
Environment=PATH=/opt/cometail/bin:/usr/bin:/bin
Environment=COMETAIL_MODE=indexer
# tsx by its real entry point: the .bin shim is a shell script, not something node runs
ExecStart=/opt/cometail/bin/node /opt/cometail/repo/worker/node_modules/tsx/dist/cli.mjs src/index.ts
# exit status 2: the API port is already taken on the box; fix that, do not restart into it
Restart=on-failure
RestartPreventExitStatus=2
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
