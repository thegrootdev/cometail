[Unit]
Description=COMETAIL indexer, Sky scan and read API (loopback only; Caddy in front)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
WorkingDirectory=/opt/cometail/worker
EnvironmentFile=/etc/cometail/worker.env
Environment=COMETAIL_MODE=indexer
ExecStart=/opt/cometail/node /opt/cometail/worker/node_modules/.bin/tsx src/index.ts
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
