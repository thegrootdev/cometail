[Unit]
Description=COMETAIL keeper (migrate, register, cash out, harvest, pair, route, settle)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
WorkingDirectory=/opt/cometail/repo/worker
EnvironmentFile=/etc/cometail/worker.env
Environment=PATH=/opt/cometail/bin:/usr/bin:/bin
Environment=COMETAIL_MODE=keeper
# tsx by its real entry point: the .bin shim is a shell script, not something node runs
ExecStart=/opt/cometail/bin/node /opt/cometail/repo/worker/node_modules/tsx/dist/cli.mjs src/index.ts
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
