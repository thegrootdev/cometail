# Copy to .env.local for local work. Vercel gets the same names as project environment variables.
NEXT_PUBLIC_CLUSTER=devnet
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com   # production: a keyed devnet RPC (see docs/hosting.md)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8841            # production: https://api.cometail.fun
NEXT_PUBLIC_OFFICIAL_MINT=                            # the protocol's own token, pinned on Explore and the home page once live
NEXT_PUBLIC_HIDDEN_MINTS=                             # comma-separated mints kept out of the lists (pages stay reachable by link)
