{
  "name": "@cometail/tests",
  "private": true,
  "version": "0.1.0",
  "description": "LiteSVM test harness running the vault program against the live mainnet Meteora binaries.",
  "scripts": {
    "test": "ts-mocha -p ./tsconfig.json -t 1000000 \"harness/**/*.test.ts\" \"regression/**/*.test.ts\" \"gates/**/*.test.ts\"",
    "smoke": "ts-mocha -p ./tsconfig.json -t 1000000 harness/smoke.test.ts",
    "regression": "ts-mocha -p ./tsconfig.json -t 1000000 \"regression/**/*.test.ts\"",
    "build:forwarder": "cd programs/test_forwarder && cargo build-sbf"
  },
  "dependencies": {
    "@anchor-lang/core": "1.0.2",
    "@coral-xyz/anchor": "0.31.1",
    "@meteora-ag/cp-amm-sdk": "1.5.1",
    "@meteora-ag/dlmm": "1.9.14",
    "@meteora-ag/dynamic-bonding-curve-sdk": "1.5.13",
    "@solana/spl-token": "0.4.13",
    "@solana/web3.js": "1.98.4",
    "bn.js": "5.2.1",
    "chai": "4.5.0",
    "decimal.js": "10.5.0",
    "litesvm": "0.1.0",
    "mocha": "10.8.2",
    "ts-mocha": "10.0.0",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@types/bn.js": "5.1.6",
    "@types/chai": "4.3.20",
    "@types/mocha": "10.0.10",
    "@types/node": "22.10.2"
  }
}
