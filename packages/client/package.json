{
  "name": "@cometail/client",
  "version": "0.1.0",
  "description": "TypeScript client for the COMETAIL vault and burn programs: PDAs, instruction builders, account decoders.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "sync-idl": "cp ../../target/idl/cometail_vault.json idl/cometail_vault.json && cp ../../target/idl/cometail_burn.json idl/cometail_burn.json"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.31.1",
    "@solana/spl-token": "0.4.13",
    "@solana/web3.js": "1.98.4",
    "bn.js": "5.2.1"
  },
  "devDependencies": {
    "@types/bn.js": "5.1.6",
    "typescript": "5.9.3"
  }
}
